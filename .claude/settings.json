{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "additionalDirectories": [
      "./ielts-backend",
      "./ielts-frontend"
    ],
    "allow": [
      "Read(./ielts-backend/**)",
      "Read(./ielts-frontend/**)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run pyright *)",
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx vitest run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/.env.development)",
      "Write(**/.env.production)",
      "Write(**/.env.staging)",
      "Write(**/.env.test)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Bash(type *.env)",
      "Bash(type *.env.*)",
      "Bash(head *.env)",
      "Bash(head *.env.*)",
      "Bash(tail *.env)",
      "Bash(tail *.env.*)",
      "Bash(less *.env)",
      "Bash(less *.env.*)",
      "Bash(more *.env)",
      "Bash(more *.env.*)",
      "Bash(grep *.env)",
      "Bash(grep *.env.*)",
      "Bash(rg *.env)",
      "Bash(rg *.env.*)",
      "Bash(Get-Content *.env)",
      "Bash(Get-Content *.env.*)"
    ]
  }
}
