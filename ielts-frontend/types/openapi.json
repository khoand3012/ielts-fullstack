 "components": {
  "schemas": {
   "AnswerInput": {
    "properties": {
     "question": {
      "type": "integer",
      "title": "Question"
     },
     "value": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Value"
     }
    },
    "type": "object",
    "required": [
     "question",
     "value"
    ],
    "title": "AnswerInput"
   },
   "AnswersRequest": {
    "properties": {
     "answers": {
      "items": {
       "$ref": "#/components/schemas/AnswerInput"
      },
      "type": "array",
      "maxItems": 100,
      "minItems": 1,
      "title": "Answers"
     }
    },
    "type": "object",
    "required": [
     "answers"
    ],
    "title": "AnswersRequest"
   },
   "AnswersResponse": {
    "properties": {
     "answers": {
      "additionalProperties": true,
      "type": "object",
      "title": "Answers"
     }
    },
    "type": "object",
    "required": [
     "answers"
    ],
    "title": "AnswersResponse"
   },
   "CommentKind": {
    "type": "string",
    "enum": [
     "strength",
     "improvement"
    ],
    "title": "CommentKind",
    "description": "Whether a Writing feedback comment praises something or points to a way to improve."
   },
   "Criterion": {
    "type": "string",
    "enum": [
     "task_achievement",
     "task_response",
     "coherence_cohesion",
     "lexical_resource",
     "grammatical_range_accuracy"
    ],
    "title": "Criterion",
    "description": "IELTS Writing criteria; Task 1 is judged on Task Achievement, Task 2 on Task Response."
   },
   "GradingMethod": {
    "type": "string",
    "enum": [
     "auto",
     "ai",
     "human"
    ],
    "title": "GradingMethod"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoginRequest": {
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
     },
     "password": {
      "type": "string",
      "title": "Password"
     }
    },
    "type": "object",
    "required": [
     "email",
     "password"
    ],
    "title": "LoginRequest"
   },
   "Module": {
    "type": "string",
    "enum": [
     "academic",
     "general_training"
    ],
    "title": "Module",
    "description": "Which Reading test a version is: it picks the raw-mark band table."
   },
   "Plan": {
    "type": "string",
    "enum": [
     "free",
     "paid"
    ],
    "title": "Plan"
   },
   "RefreshRequest": {
    "properties": {
     "refresh_token": {
      "type": "string",
      "title": "Refresh Token"
     }
    },
    "type": "object",
    "required": [
     "refresh_token"
    ],
    "title": "RefreshRequest"
   },
   "RegisterRequest": {
    "properties": {
     "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
     },
     "password": {
      "type": "string",
      "maxLength": 128,
      "minLength": 8,
      "title": "Password"
     }
    },
    "type": "object",
    "required": [
     "email",
     "password"
    ],
    "title": "RegisterRequest"
   },
   "ResultQuestion": {
    "properties": {
     "number": {
      "type": "integer",
      "title": "Number"
     },
     "numbers": {
      "items": {
       "type": "integer"
      },
      "type": "array",
      "title": "Numbers"
     },
     "kind": {
      "type": "string",
      "enum": [
       "text",
       "single_choice",
       "choice"
      ],
      "title": "Kind"
     },
     "answer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Answer"
     },
     "accepted": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Accepted"
     },
     "correct_choices": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Correct Choices"
     },
     "marks": {
      "type": "integer",
      "title": "Marks"
     },
     "max_marks": {
      "type": "integer",
      "title": "Max Marks"
     },
     "section": {
      "type": "integer",
      "title": "Section"
     },
     "question_type": {
      "type": "string",
      "title": "Question Type"
     }
    },
    "type": "object",
    "required": [
     "number",
     "numbers",
     "kind",
     "answer",
     "accepted",
     "correct_choices",
     "marks",
     "max_marks",
     "section",
     "question_type"
    ],
    "title": "ResultQuestion"
   },
   "ResultSection": {
    "properties": {
     "number": {
      "type": "integer",
      "title": "Number"
     },
     "title": {
      "type": "string",
      "title": "Title"
     }
    },
    "type": "object",
    "required": [
     "number",
     "title"
    ],
    "title": "ResultSection"
